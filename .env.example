POSTGRES_USER=agrosat
POSTGRES_PASSWORD=agrosat
POSTGRES_DB=agrosat

PORT=3001
DATABASE_URL=postgresql://agrosat:agrosat@localhost:5432/agrosat
REDIS_URL=redis://localhost:6379
WORKER_URL=http://localhost:8000
WORKER_TIMEOUT_MS=120000
DATA_DIR=/data
WEB_ORIGIN=http://localhost:3005
# rate limit por IP: THROTTLE_LIMIT requisições a cada THROTTLE_TTL segundos (alto, pois o web faz polling)
THROTTLE_LIMIT=600
THROTTLE_TTL=60
PUBLIC_FILES_URL=http://localhost:3001/api/v1/files

DATA_MODE=fixtures
STAC_URL=https://earth-search.aws.element84.com/v1
STAC_COLLECTION=sentinel-2-l2a
STAC_TIMEOUT_S=10
FIXTURES_DIR=/app/fixtures

NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# porta do host da API (mude se 3001 estiver ocupada)
API_HOST_PORT=3001

# worker sem porta pública; para depurar: docker compose --profile debug up -d worker-debug
WORKER_HOST_PORT=8000
